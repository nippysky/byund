// ============================================================
// BYUND Governance — Prisma 7 Schema
// NIPPYSKY LIMITED · Version 1.0
// PostgreSQL 16 · Multi-tenant row-isolated architecture
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["queryRawTyped", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TenantPlan {
  STARTER
  GROWTH
  ENTERPRISE

  @@map("tenant_plan")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("tenant_status")
}

enum OrgStatus {
  ACTIVE
  INACTIVE

  @@map("org_status")
}

enum TeamType {
  ENGINEERING
  SECURITY
  COMPLIANCE
  OPERATIONS
  DEVOPS
  MANAGEMENT
  OTHER

  @@map("team_type")
}

enum TeamStatus {
  ACTIVE
  INACTIVE

  @@map("team_status")
}

enum TeamRole {
  LEAD
  MEMBER

  @@map("team_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum AssetType {
  SERVER
  APPLICATION
  DATABASE
  WEBSITE
  SSL_CERTIFICATE
  FIREWALL
  SWITCH
  STORAGE
  CLUSTER
  OTHER

  @@map("asset_type")
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  DR
  OTHER

  @@map("environment")
}

enum RiskRating {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL

  @@map("risk_rating")
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
  DECOMMISSIONED

  @@map("asset_status")
}

enum ReviewFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  MANUAL

  @@map("review_frequency")
}

enum ReviewType {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  MANUAL
  COMPLIANCE

  @@map("review_type")
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
  OVERDUE

  @@map("review_status")
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL

  @@map("severity")
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ACCEPTED_RISK

  @@map("finding_status")
}

enum DocumentType {
  EVIDENCE
  POLICY
  PROCEDURE
  REPORT
  SCREENSHOT
  CERTIFICATE
  OTHER

  @@map("document_type")
}

enum NotificationType {
  REVIEW_DUE
  REVIEW_OVERDUE
  REVIEW_ASSIGNED
  REVIEW_COMPLETED
  REVIEW_APPROVED
  REVIEW_REJECTED
  FINDING_ASSIGNED
  FINDING_DUE
  FINDING_OVERDUE
  FINDING_RESOLVED
  ASSET_EXPIRING
  SYSTEM

  @@map("notification_type")
}

enum NotificationChannel {
  IN_APP
  EMAIL

  @@map("notification_channel")
}

// ============================================================
// TENANT
// Root billing/account unit. One per SaaS customer.
// ============================================================

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(STARTER)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  organizations Organization[]
  users         User[]

  @@map("tenants")
}

// ============================================================
// ORGANIZATION
// Operational unit. V1: 1 org per tenant. V1.1: many orgs per tenant.
// ============================================================

model Organization {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  slug        String
  description String?
  logoUrl     String?   @map("logo_url")
  website     String?
  industry    String?
  status      OrgStatus @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teams         Team[]
  users         User[]
  assets        Asset[]
  reviews       Review[]
  findings      Finding[]
  documents     EvidenceDocument[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("organizations")
}

// ============================================================
// TEAM
// Logical group of users within an org.
// ============================================================

model Team {
  id             String     @id @default(cuid())
  tenantId       String     @map("tenant_id")
  organizationId String     @map("organization_id")
  name           String
  description    String?
  teamType       TeamType   @default(ENGINEERING) @map("team_type")
  status         TeamStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships        TeamMembership[]
  technicalAssets    Asset[]          @relation("TechnicalOwnerTeam")
  assignedFindings   Finding[]        @relation("AssignedTeam")

  @@index([organizationId])
  @@index([tenantId])
  @@map("teams")
}

// ============================================================
// USER
// ============================================================

model User {
  id             String     @id @default(cuid())
  tenantId       String     @map("tenant_id")
  organizationId String     @map("organization_id")
  email          String
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  avatarUrl      String?    @map("avatar_url")
  jobTitle       String?    @map("job_title")
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false) @map("email_verified")
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  userRoles     UserRole[]
  memberships   TeamMembership[]
  refreshTokens RefreshToken[]

  // Asset ownership
  technicalAssets Asset[] @relation("TechnicalOwner")
  businessAssets  Asset[] @relation("BusinessOwner")

  // Review involvement
  assignedReviews Review[] @relation("AssignedReviewer")
  approvedReviews Review[] @relation("ReviewApprover")

  // Finding involvement
  assignedFindings Finding[] @relation("FindingAssignee")

  // Documents uploaded
  uploadedDocuments EvidenceDocument[]

  // Notifications
  notifications Notification[]

  // Audit trail
  activityLogs ActivityLog[]

  @@unique([tenantId, email])
  @@index([organizationId])
  @@index([tenantId])
  @@map("users")
}

// ============================================================
// REFRESH TOKEN
// Used for JWT rotation. Revoked on use.
// ============================================================

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// ROLE
// System-defined roles. No custom roles in v1.
// ============================================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String   // e.g. "governance_admin"
  displayName String   @map("display_name") // e.g. "Governance Admin"
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

// ============================================================
// PERMISSION
// Fine-grained resource:action pairs. Seeded, not user-created.
// ============================================================

model Permission {
  id          String @id @default(cuid())
  name        String @unique // e.g. "asset:create"
  displayName String @map("display_name")
  resource    String // e.g. "asset"
  action      String // e.g. "create"
  description String?

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

// ============================================================
// ROLE_PERMISSION (junction)
// ============================================================

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// USER_ROLE (junction)
// ============================================================

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// TEAM_MEMBERSHIP (junction)
// ============================================================

model TeamMembership {
  id       String   @id @default(cuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_memberships")
}

// ============================================================
// ASSET
// Central entity. Everything else references an asset.
// ============================================================

model Asset {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  organizationId String          @map("organization_id")

  // Core identity
  name        String
  assetType   AssetType   @map("asset_type")
  environment Environment
  description String?
  riskRating  RiskRating  @default(MEDIUM) @map("risk_rating")
  status      AssetStatus @default(ACTIVE)

  // Ownership
  technicalOwnerId String? @map("technical_owner_id")
  businessOwnerId  String? @map("business_owner_id")
  teamId           String? @map("team_id")

  // Review scheduling
  reviewFrequency ReviewFrequency @map("review_frequency")
  nextReviewDate  DateTime?       @map("next_review_date")
  lastReviewedAt  DateTime?       @map("last_reviewed_at")

  // For time-sensitive assets (SSL certs, contracts)
  expiresAt DateTime? @map("expires_at")

  // Flexible metadata (e.g. IP address, hostname, port, region)
  tags     String[] @default([])
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  technicalOwner User?        @relation("TechnicalOwner", fields: [technicalOwnerId], references: [id])
  businessOwner  User?        @relation("BusinessOwner", fields: [businessOwnerId], references: [id])
  team           Team?        @relation("TechnicalOwnerTeam", fields: [teamId], references: [id])

  reviews   Review[]
  findings  Finding[]
  documents EvidenceDocument[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([assetType])
  @@index([status])
  @@index([nextReviewDate])
  @@index([expiresAt])
  @@map("assets")
}

// ============================================================
// REVIEW
// A single review event for an asset.
// ============================================================

model Review {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  organizationId String       @map("organization_id")
  assetId        String       @map("asset_id")

  title       String
  description String?
  reviewType  ReviewType   @map("review_type")
  status      ReviewStatus @default(PENDING)

  // People
  assignedToId String? @map("assigned_to_id")
  approvedById String? @map("approved_by_id")

  // Dates
  scheduledDate DateTime  @map("scheduled_date")
  dueDate       DateTime  @map("due_date")
  completedAt   DateTime? @map("completed_at")
  approvedAt    DateTime? @map("approved_at")

  // Content
  reviewerNotes  String? @map("reviewer_notes")
  approverNotes  String? @map("approver_notes")
  findingSummary String? @map("finding_summary") // free-text summary by reviewer

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id])
  assignedTo   User?        @relation("AssignedReviewer", fields: [assignedToId], references: [id])
  approvedBy   User?        @relation("ReviewApprover", fields: [approvedById], references: [id])

  documents EvidenceDocument[]
  findings  Finding[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([assetId])
  @@index([status])
  @@index([dueDate])
  @@map("reviews")
}

// ============================================================
// REVIEW_SCHEDULE
// Tracks when each asset's next review job should fire.
// Managed by BullMQ scheduler.
// ============================================================

model ReviewSchedule {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  organizationId String          @map("organization_id")
  assetId        String          @unique @map("asset_id") // one active schedule per asset

  frequency  ReviewFrequency
  nextRunAt  DateTime        @map("next_run_at")
  lastRunAt  DateTime?       @map("last_run_at")
  isActive   Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nextRunAt, isActive])
  @@map("review_schedules")
}

// ============================================================
// FINDING
// Audit finding raised during or independent of a review.
// ============================================================

model Finding {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  organizationId String        @map("organization_id")

  // References (both optional — finding can be standalone)
  assetId  String? @map("asset_id")
  reviewId String? @map("review_id")

  // Core fields
  title           String
  description     String
  severity        Severity
  status          FindingStatus @default(OPEN)
  remediationPlan String?       @map("remediation_plan")

  // Assignment
  assignedTeamId String? @map("assigned_team_id")
  assignedToId   String? @map("assigned_to_id")

  // Dates
  dueDate    DateTime? @map("due_date")
  resolvedAt DateTime? @map("resolved_at")
  closedAt   DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset?       @relation(fields: [assetId], references: [id])
  review       Review?      @relation(fields: [reviewId], references: [id])
  assignedTeam Team?        @relation("AssignedTeam", fields: [assignedTeamId], references: [id])
  assignedTo   User?        @relation("FindingAssignee", fields: [assignedToId], references: [id])

  documents EvidenceDocument[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@index([severity])
  @@index([dueDate])
  @@map("findings")
}

// ============================================================
// EVIDENCE_DOCUMENT
// Metadata record for an uploaded file.
// Actual bytes live in MinIO. This is the PostgreSQL reference.
// ============================================================

model EvidenceDocument {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  organizationId String       @map("organization_id")

  // File metadata
  name         String       // user-supplied name
  originalName String       @map("original_name") // filename at upload time
  mimeType     String       @map("mime_type")
  fileSize     Int          @map("file_size") // bytes
  storageKey   String       @map("storage_key") // e.g. "tenants/clx.../findings/clx.../evidence.pdf"
  storageBucket String      @map("storage_bucket") // MinIO bucket name

  documentType DocumentType @map("document_type")
  description  String?

  // Polymorphic associations (at least one must be set)
  assetId   String? @map("asset_id")
  reviewId  String? @map("review_id")
  findingId String? @map("finding_id")

  uploadedById String @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset?       @relation(fields: [assetId], references: [id])
  review       Review?      @relation(fields: [reviewId], references: [id])
  finding      Finding?     @relation(fields: [findingId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([assetId])
  @@index([reviewId])
  @@index([findingId])
  @@map("evidence_documents")
}

// ============================================================
// NOTIFICATION
// In-app + email notification record.
// ============================================================

model Notification {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  organizationId String              @map("organization_id")
  userId         String              @map("user_id")

  type    NotificationType
  channel NotificationChannel @default(IN_APP)
  title   String
  message String

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  // Deep-link reference
  entityType String? @map("entity_type") // "asset" | "review" | "finding"
  entityId   String? @map("entity_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
  @@map("notifications")
}

// ============================================================
// ACTIVITY_LOG
// Immutable append-only audit trail.
// No updates. No deletes. Ever.
// ============================================================

model ActivityLog {
  id             String @id @default(cuid())
  tenantId       String @map("tenant_id")
  organizationId String @map("organization_id")
  userId         String? @map("user_id") // null for system-generated events

  // What happened
  action     String // e.g. "review.approved", "finding.created", "asset.updated"
  entityType String @map("entity_type") // "review" | "finding" | "asset" | "user" | ...
  entityId   String @map("entity_id")
  entityName String? @map("entity_name") // snapshot of name at time of action

  // Change diff (before/after for updates)
  changes  Json?
  metadata Json? // ipAddress, userAgent, requestId

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("activity_logs")
}
