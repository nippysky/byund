# ── Dependencies ──────────────────────────────────────────
node_modules
apps/*/node_modules
packages/*/node_modules
.pnp
.pnp.*

# ── Package manager artifacts ──────────────────────────────
.pnpm-store
pnpm-lock.yaml
# Note: package-lock.json IS committed (we use npm)

# ── Next.js build output ───────────────────────────────────
.next
out
build
dist

# ── Environment files ─────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
# Keep .env.example files — they document required vars

# ── Prisma generated output ───────────────────────────────
*.tsbuildinfo
lib/generated/
apps/*/lib/generated/

# ── Uploads (server-side file storage) ───────────────────
apps/governance/uploads/

# ── OS & editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea
.vscode/*
!.vscode/extensions.json

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel ────────────────────────────────────────────────
.vercel

# ── Testing ───────────────────────────────────────────────
coverage
